rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Ensure user is authenticated
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /journal_entries/{entryId} {
      // Assuming entry contains a 'userId' field
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /friends/{docId} {
      // Document ID should be a composite of user1_user2 or contain an array of participants
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow write: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
    }

    match /global_checkins/{checkinId} {
      // Any authenticated user can read global checkins for the 4D matrix globe
      allow read: if isAuthenticated();
      // Only the authenticated owner can create their own checkin
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only owner can update or delete their checkin
      allow update, delete: if isOwner(resource.data.userId);
    }
  }
}
